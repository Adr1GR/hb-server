{
    "version": 2,
    "name": "horsebreeders-backend",
    "builds": [
      {
        "src": "src/webApi/index.ts",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/api/(.*)",
        "dest": "src/webApi/index.ts"
      }
    ],
    "env": {
      "CORS_ALLOWED_ORIGIN": "https://horsebreeders.vercel.app"
    },
    "functions": {
      "api/*": {
        "memory": 256,
        "maxDuration": 10
      }
    }
  }
  